# ==============================================================================
# .env.example — E-commerce Saga Project Environment Variables Reference
# ==============================================================================
# Copy this file to `.env` before running docker compose locally or deploying.
# Usage:
#   cp .env.example .env
#   docker compose -f docker-compose.yml -f docker-compose.monitoring.yml up -d
# ==============================================================================

# ─── 1. Database Credentials ──────────────────────────────────────────────────
# Used in: order-service, inventory-service, payment-service, notification-service application.yml
# H2 in-memory credentials. Change these for production deployments.
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=root

# Used in: Infrastructure/docker-compose.prod.yml (Enables H2 DB web console)
# H2_CONSOLE_ENABLED=true


# ─── 2. Kafka & Messaging Configuration ───────────────────────────────────────
# Used in: docker-compose.yml (Kafka KRaft broker listeners)
# Internal port used within the Docker bridge network (saga-net).
KAFKA_PORT_INTERNAL=9092
# External port accessible from host / laptop for local debugging.
KAFKA_PORT_EXTERNAL=9094

# Used in: docker-compose.yml (SPRING_KAFKA_BOOTSTRAP_SERVERS)
# SPRING_KAFKA_BOOTSTRAP_SERVERS=kafka:9092


# ─── 3. Microservice HTTP Ports ───────────────────────────────────────────────
# Used in: docker-compose.yml (Port mappings for Spring Boot microservices & Kafka UI)
ORDER_SERVICE_PORT=8081
INVENTORY_SERVICE_PORT=8082
PAYMENT_SERVICE_PORT=8083
NOTIFICATION_SERVICE_PORT=8084
KAFKA_UI_PORT=8090


# ─── 4. Inter-Service Communication URLs (Docker Network DNS) ────────────────
# Used in: order-service, inventory-service, payment-service application.yml
# These resolve correctly inside the Docker bridge network (saga-net).
INVENTORY_SERVICE_URL=http://inventory-service:8082
PAYMENT_SERVICE_URL=http://payment-service:8083
NOTIFICATION_SERVICE_URL=http://notification-service:8084

# Used in: notification-service (Third-party API mock integrations)
EMAIL_SERVICE_URL=https://api.email-provider.com
SMS_SERVICE_URL=https://api.sms-provider.com


# ─── 5. Observability Stack (Grafana, Prometheus, Loki, Exporters) ───────────
# Used in: docker-compose.monitoring.yml (Grafana UI Web Interface)
GRAFANA_PORT=3000
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin

# Used in: docker-compose.monitoring.yml (Prometheus Metrics Database)
PROMETHEUS_PORT=9090

# Used in: docker-compose.monitoring.yml (Grafana Loki Log Engine)
LOKI_PORT=3100

# Used in: docker-compose.yml (cAdvisor container CPU/Memory/Network exporter)
CADVISOR_PORT=8080

# Used in: docker-compose.yml (Node Exporter system host metrics)
NODE_EXPORTER_PORT=9100

# Used in: docker-compose.yml & config/promtail-config.yml (Promtail log shipping target)
LOKI_URL=http://loki:3100/loki/api/v1/push

# Used in: Legacy Prometheus target placeholder (replaced by container DNS in config/prometheus.yml)
# APP_HOST=app


# ─── 6. AWS Infrastructure & Terraform Parameters (Reference Only) ───────────
# Used in: Infrastructure/variables.tf & GitHub Actions deploy.yml
# AWS_REGION=ap-south-1
# EC2_INSTANCE_TYPE=t3.small
# PROJECT_NAME=ecom-saga
