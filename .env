# ==============================================================================
# E-commerce Saga Project Local Environment Variables (.env)
# ==============================================================================

# ─── 1. Database Credentials ──────────────────────────────────────────────────
# Used in: order-service, inventory-service, payment-service, notification-service
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=root
# H2_CONSOLE_ENABLED=true (Used in Infrastructure/docker-compose.prod.yml)


# ─── 2. Kafka & Messaging Configuration ───────────────────────────────────────
# Used in: docker-compose.yml for Kafka KRaft broker listeners
KAFKA_PORT_INTERNAL=9092
KAFKA_PORT_EXTERNAL=9094
# SPRING_KAFKA_BOOTSTRAP_SERVERS=kafka:9092


# ─── 3. Microservice HTTP Ports ───────────────────────────────────────────────
# Used in: docker-compose.yml for host port mapping
ORDER_SERVICE_PORT=8081
INVENTORY_SERVICE_PORT=8082
PAYMENT_SERVICE_PORT=8083
NOTIFICATION_SERVICE_PORT=8084
KAFKA_UI_PORT=8090


# ─── 4. Inter-Service Communication URLs ─────────────────────────────────────
# Used in: order-service, inventory-service, payment-service application.yml
INVENTORY_SERVICE_URL=http://inventory-service:8082
PAYMENT_SERVICE_URL=http://payment-service:8083
NOTIFICATION_SERVICE_URL=http://notification-service:8084
EMAIL_SERVICE_URL=https://api.email-provider.com
SMS_SERVICE_URL=https://api.sms-provider.com


# ─── 5. Observability Stack (Grafana, Prometheus, Loki, Exporters) ───────────
# Used in: docker-compose.monitoring.yml (Grafana UI Dashboard)
GRAFANA_PORT=3000
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin

# Used in: docker-compose.monitoring.yml (Prometheus & Loki)
PROMETHEUS_PORT=9090
LOKI_PORT=3100

# Used in: docker-compose.yml (cAdvisor & Node Exporter)
CADVISOR_PORT=8080
NODE_EXPORTER_PORT=9100

# Used in: docker-compose.yml & config/promtail-config.yml (Promtail Log Shipper)
LOKI_URL=http://loki:3100/loki/api/v1/push

# APP_HOST=app (Legacy placeholder, replaced by container DNS in config/prometheus.yml)


# ─── 6. AWS Infrastructure Parameters (Reference Only) ───────────────────────
# AWS_REGION=ap-south-1 (Used in Infrastructure/variables.tf)
# EC2_INSTANCE_TYPE=t3.small (Used in Infrastructure/variables.tf)
# PROJECT_NAME=ecom-saga (Used in Infrastructure/variables.tf)